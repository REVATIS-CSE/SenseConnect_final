<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    style="@style/Widget.SenseConnect.Card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="112dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/icon"
            style="@style/SenseConnect.IconTile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_tile"
            android:padding="9dp" />

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.SenseConnect.Title"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/sublabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SenseConnect.Caption" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
