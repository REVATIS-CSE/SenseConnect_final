<?xml version="1.0" encoding="utf-8"?>
<!--
    SenseConnect dashboard. Information architecture:
    System status → Assistive services → Quick actions → Recent activity → Service availability → Emergency access
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- ============ Brand header ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_brand_gradient"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_logo_mark"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.SenseConnect.TitleLarge"
                    tools:targetApi="p" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_descriptor"
                    android:textAppearance="@style/TextAppearance.SenseConnect.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHeaderSos"
                style="@style/Widget.SenseConnect.Button.Emergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_open_sos"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="@string/sos"
                app:icon="@drawable/ic_emergency"
                app:iconPadding="6dp"
                app:iconSize="20dp" />
        </LinearLayout>

        <!-- ============ Greeting ============ -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAppearance="@style/TextAppearance.SenseConnect.Display"
            tools:text="Good afternoon" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SenseConnect.Supporting"
            tools:text="Friday, 2 October" />

        <!-- ============ 1. System status (hero) ============ -->
        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_brand_gradient"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/system_status"
                    android:textAppearance="@style/TextAppearance.SenseConnect.Overline"
                    android:textColor="#D9FFFFFF" />

                <TextView
                    android:id="@+id/tvHeroCloud"
                    style="@style/SenseConnect.StatusPill"
                    android:backgroundTint="#33FFFFFF"
                    android:drawableTint="@color/white"
                    android:textColor="@color/white"
                    tools:text="Cloud online" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.SenseConnect.ScreenTitle"
                android:textColor="@color/white"
                tools:text="Ready to assist" />

            <TextView
                android:id="@+id/tvHeroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.SenseConnect.Supporting"
                android:textColor="#E6FFFFFF"
                tools:text="All 5 services available. Core features work offline." />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/heroCapabilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo_mark"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/motto"
                    android:textAppearance="@style/TextAppearance.SenseConnect.Status"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_surface"
            android:backgroundTint="@color/sc_tertiary_container"
            android:drawableStart="@drawable/ic_info"
            android:drawablePadding="10dp"
            android:drawableTint="@color/sc_on_tertiary_container"
            android:padding="14dp"
            android:textAppearance="@style/TextAppearance.SenseConnect.Supporting"
            android:textColor="@color/sc_on_tertiary_container"
            android:visibility="gone"
            tools:text="Server announcement" />

        <!-- ============ 2. Assistive services ============ -->
        <TextView
            style="@style/SenseConnect.SectionHeader"
            android:text="@string/section_services" />

        <include
            android:id="@+id/serviceVision"
            layout="@layout/item_service_card" />

        <include
            android:id="@+id/serviceHearing"
            layout="@layout/item_service_card" />

        <include
            android:id="@+id/serviceCommunication"
            layout="@layout/item_service_card" />

        <!-- ============ 3. Quick actions ============ -->
        <TextView
            style="@style/SenseConnect.SectionHeader"
            android:layout_marginTop="16dp"
            android:text="@string/section_quick_actions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/qaScan"
                layout="@layout/item_quick_action" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/qaListen"
                layout="@layout/item_quick_action" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/qaSpeak"
                layout="@layout/item_quick_action" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/qaLocation"
                layout="@layout/item_quick_action" />
        </LinearLayout>

        <!-- ============ 4. Recent activity ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SenseConnect.SectionHeader"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/section_recent_activity" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewAllActivity"
                style="@style/Widget.SenseConnect.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/view_all" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/recentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="6dp"
                android:paddingEnd="18dp"
                android:paddingBottom="6dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 5. Service availability ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SenseConnect.SectionHeader"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/section_service_status" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshStatus"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/cd_refresh_status"
                app:icon="@drawable/ic_refresh"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/statusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 6. Emergency access ============ -->
        <TextView
            style="@style/SenseConnect.SectionHeader"
            android:text="@string/section_emergency" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/emergencyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/sc_emergency_container"
            app:strokeColor="@color/sc_emergency"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/SenseConnect.IconTile"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_icon_tile"
                        android:backgroundTint="@color/sc_emergency"
                        android:padding="13dp"
                        android:src="@drawable/ic_emergency"
                        app:tint="@color/sc_on_emergency" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/emergency_card_title"
                            android:textAppearance="@style/TextAppearance.SenseConnect.Title"
                            android:textColor="@color/sc_on_emergency_container" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/emergency_card_body"
                            android:textAppearance="@style/TextAppearance.SenseConnect.Supporting"
                            android:textColor="@color/sc_on_emergency_container" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmergencyContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawableStart="@drawable/ic_person"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/sc_on_emergency_container"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.SenseConnect.Status"
                    android:textColor="@color/sc_on_emergency_container"
                    tools:text="Contact: Mom · +91 98xxxxxx" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenSos"
                    style="@style/Widget.SenseConnect.Button.Emergency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/open_sos"
                    app:icon="@drawable/ic_emergency" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.SenseConnect.Caption"
            tools:text="SenseConnect 2.0.0 · On-device processing" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
