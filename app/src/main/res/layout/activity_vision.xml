<?xml version="1.0" encoding="utf-8"?>
<!-- Vision Assistance: Camera → On-device OCR → Recognised text → Read aloud -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <include
        android:id="@+id/header"
        layout="@layout/view_feature_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============ Camera ============ -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_rounded_surface"
        android:backgroundTint="#FF0B0E13"
        app:layout_constraintBottom_toTopOf="@id/panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_camera_preview" />

        <com.example.senseconnect.ui.vision.ScanOverlayView
            android:id="@+id/scanOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvGuide"
            style="@style/SenseConnect.StatusPill"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:backgroundTint="#B3000000"
            android:drawableTint="@color/white"
            android:textColor="@color/white"
            tools:text="Align text inside the frame" />

        <!-- OCR progress -->
        <LinearLayout
            android:id="@+id/processingOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_rounded_surface"
            android:backgroundTint="#E6000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/sc_scan_frame_active"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/vision_processing"
                android:textAppearance="@style/TextAppearance.SenseConnect.Status"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Permission / error / unavailable states for the camera -->
        <include
            android:id="@+id/cameraState"
            layout="@layout/view_state_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============ Results + controls ============ -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/vision_result_title"
                        android:textAppearance="@style/TextAppearance.SenseConnect.Title"
                        tools:targetApi="p" />

                    <TextView
                        android:id="@+id/tvResultMeta"
                        style="@style/SenseConnect.StatusPill"
                        tools:text="42 words" />
                </LinearLayout>

                <!-- Empty / error state inside the result card -->
                <LinearLayout
                    android:id="@+id/resultEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivEmptyIcon"
                        style="@style/SenseConnect.IconTile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_tile"
                        android:padding="9dp"
                        android:src="@drawable/ic_text_fields" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textAppearance="@style/TextAppearance.SenseConnect.Body"
                            tools:text="No text captured" />

                        <TextView
                            android:id="@+id/tvEmptyBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.SenseConnect.Supporting"
                            tools:text="Point the camera at printed text and tap Scan." />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/resultContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rounded_surface"
                        android:maxLines="6"
                        android:padding="12dp"
                        android:scrollbars="vertical"
                        android:textAppearance="@style/TextAppearance.SenseConnect.Body"
                        android:textIsSelectable="true"
                        android:textSize="17sp"
                        tools:text="Recognised text appears here." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReadAloud"
                            style="@style/Widget.SenseConnect.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/read_aloud"
                            app:icon="@drawable/ic_volume_up" />

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopy"
                            style="@style/Widget.SenseConnect.Button.IconOnly"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/copy"
                            app:icon="@drawable/ic_content_copy" />

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShare"
                            style="@style/Widget.SenseConnect.Button.IconOnly"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/share"
                            app:icon="@drawable/ic_share" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGallery"
                            style="@style/Widget.SenseConnect.Button.IconOnly"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:contentDescription="@string/scan_from_gallery"
                            app:icon="@drawable/ic_add_circle_outline" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                style="@style/Widget.SenseConnect.Button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/scan_text"
                android:textSize="17sp"
                app:icon="@drawable/ic_document_scanner"
                app:iconSize="26dp" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClear"
                            style="@style/Widget.SenseConnect.Button.IconOnly"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:contentDescription="@string/clear"
                            app:icon="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
