<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SenseConnect"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="One Device. Three Disabilities."
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/tvDeviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● Device Disconnected"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnBlind"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="👁  Vision Assistance"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnDeaf"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="👂  Hearing Assistance"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSpeech"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🗣  Communication"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🚨  SOS Emergency"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>

</ScrollView>