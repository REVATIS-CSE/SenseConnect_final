<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules (API 31+). Settings and custom phrases may be backed up; activity history never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="senseconnect_settings.xml" />
        <include domain="sharedpref" path="senseconnect_phrases.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="senseconnect_settings.xml" />
        <include domain="sharedpref" path="senseconnect_phrases.xml" />
    </device-transfer>
</data-extraction-rules>
